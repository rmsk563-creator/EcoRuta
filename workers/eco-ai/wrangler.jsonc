{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ecoruta-eco-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "ecoruta-web-90b6d",
    "ALLOWED_ORIGINS": "capacitor://localhost,http://localhost,https://rmsk563-creator.github.io",
    "RATE_LIMIT_PER_MINUTE": "6",
    "RATE_LIMIT_PER_DAY": "40"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "UserRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserRateLimiter"]
    }
  ]
}
